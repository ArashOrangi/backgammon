openapi: 3.0.0
info:
  title: Backgammon Game API
  description: |
    API for a real‑time multiplayer backgammon game.
    - REST endpoints for account management, matchmaking, history, shop, tournament, etc.
    - WebSocket connection for live game events (see WebSocket section).
    - Admin endpoints for managing inventory, shop, starter packs and user inventory.
    
    **Note:** Tournament game results are automatically recorded by the server; clients do not need to send `tournament.monthly.record`.
  version: 1.0.0
  contact:
    name: Support
    url: https://example.com
servers:
  - url: http://localhost:8080
    description: Development server
  - url: http://37.255.218.236:5208
    description: Production server

tags:
  - name: Account
    description: Registration, login, logout, and password management.
  - name: Users
    description: User profiles and public data.
  - name: Games
    description: Game creation and matchmaking.
  - name: History
    description: Game history, replay, and timeline.
  - name: Timer Presets
    description: Manage timer configurations.
  - name: Mini Chat
    description: Static chat categories and messages.
  - name: Location
    description: Provinces and cities.
  - name: Shop
    description: Shop items and purchases (public).
  - name: Collection
    description: User inventory and selected items.
  - name: Leaderboard
    description: Global and period‑based leaderboards.
  - name: Tournament
    description: Weekly and Monthly tournament management, leaderboards, series.
  - name: Admin
    description: Administrative endpoints for managing inventory, shop, starter packs and user inventory (requires admin privileges).
  - name: WebSocket
    description: Real‑time game protocol (see separate documentation).

paths:
  # ===================== ACCOUNT =====================
  /api/account/register:
    post:
      tags: [Account]
      summary: Register a new user
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
      responses:
        '200':
          description: Registration successful
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthResponse'
        '400':
          description: Validation error
        '500':
          description: Server error

  /api/account/login:
    post:
      tags: [Account]
      summary: Log in with username and password
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
      responses:
        '200':
          description: Login successful
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthResponse'
        '400':
          description: Invalid credentials or validation error
        '500':
          description: Server error

  /api/account/logout:
    post:
      tags: [Account]
      summary: Log out current user
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Logged out successfully
        '401':
          description: Not authenticated
        '500':
          description: Server error

  /api/account/password/change:
    post:
      tags: [Account]
      summary: Change user password
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangePasswordRequest'
      responses:
        '200':
          description: Password changed
        '400':
          description: Validation error or old password incorrect
        '401':
          description: Not authenticated
        '500':
          description: Server error

  # ===================== USERS =====================
  /api/users:
    post:
      tags: [Users]
      summary: Create a simple user (legacy)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SimpleUserRequest'
      responses:
        '200':
          description: User created or found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '400':
          description: Validation error
        '500':
          description: Server error

  /api/users/profile/{userId}:
    get:
      tags: [Users]
      summary: Get user profile with stats and common matches
      parameters:
        - name: userId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Profile data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ProfileResponse'
        '404':
          description: User not found
        '500':
          description: Server error

    put:
      tags: [Users]
      summary: Update user profile
      security:
        - bearerAuth: []
      parameters:
        - name: userId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateProfileRequest'
      responses:
        '200':
          description: Profile updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '400':
          description: Validation error
        '401':
          description: Not authenticated
        '500':
          description: Server error

  /api/users/me:
    get:
      tags: [Users]
      summary: Get current authenticated user
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Current user data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '401':
          description: Not authenticated
        '500':
          description: Server error

  # ===================== GAMES =====================
  /api/games:
    post:
      tags: [Games]
      summary: Create a new game
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                whitePlayerId:
                  type: integer
                  description: ID of the white player
      responses:
        '200':
          description: Game created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Game'
        '400':
          description: Missing whitePlayerId
        '401':
          description: Not authenticated
        '500':
          description: Server error

  /api/games/join:
    post:
      tags: [Games]
      summary: Join matchmaking queue
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                userId:
                  type: integer
                roomType:
                  $ref: '#/components/schemas/RoomType'
      responses:
        '200':
          description: Queued or matched
          content:
            application/json:
              schema:
                oneOf:
                  - type: object
                    properties:
                      status:
                        type: string
                        enum: [waiting]
                      message:
                        type: string
                  - type: object
                    properties:
                      gameId:
                        type: integer
                      status:
                        type: string
                        enum: [matched]
                      message:
                        type: string
        '401':
          description: Not authenticated
        '500':
          description: Matchmaking failed

  # ===================== HISTORY =====================
  /api/history/{gameId}:
    get:
      tags: [History]
      summary: Get raw events of a game
      parameters:
        - name: gameId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: List of game events
          content:
            application/json:
              schema:
                type: object
                properties:
                  gameId:
                    type: integer
                  events:
                    type: array
                    items:
                      type: object
        '404':
          description: Game not found
        '500':
          description: Server error

  /api/history/{gameId}/replay:
    get:
      tags: [History]
      summary: Replay game state up to a specific sequence
      parameters:
        - name: gameId
          in: path
          required: true
          schema:
            type: integer
        - name: until
          in: query
          required: false
          schema:
            type: integer
            description: Event sequence number to replay until
      responses:
        '200':
          description: Game state at requested point
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameState'
        '404':
          description: Game state not found
        '500':
          description: Server error

  /api/history/{gameId}/timeline:
    get:
      tags: [History]
      summary: Get human‑readable timeline of events
      parameters:
        - name: gameId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Timeline entries
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    id:
                      type: integer
                    time:
                      type: integer
                    roomId:
                      type: integer
                    seq:
                      type: integer
                    revert:
                      type: boolean
                    initiator:
                      type: integer
                      nullable: true
                    event:
                      type: string
                    details:
                      type: string
                      nullable: true
        '404':
          description: Game not found
        '500':
          description: Server error

  # ===================== TIMER PRESETS =====================
  /api/timer-presets:
    get:
      tags: [Timer Presets]
      summary: Get all timer presets
      responses:
        '200':
          description: List of presets
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TimerPreset'
        '500':
          description: Server error

    post:
      tags: [Timer Presets]
      summary: Create a new timer preset (admin)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TimerPresetInput'
      responses:
        '200':
          description: Preset created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TimerPreset'
        '400':
          description: Invalid input
        '500':
          description: Server error

  /api/timer-presets/{id}:
    put:
      tags: [Timer Presets]
      summary: Update a timer preset (admin)
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TimerPresetInput'
      responses:
        '200':
          description: Preset updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TimerPreset'
        '500':
          description: Server error

    delete:
      tags: [Timer Presets]
      summary: Delete a timer preset (admin)
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Preset deleted
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
        '500':
          description: Server error

  # ===================== MINI CHAT =====================
  /api/miniChat/categories:
    get:
      tags: [Mini Chat]
      summary: Get all message categories (active only)
      responses:
        '200':
          description: List of categories with their messages
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ChatCategory'
        '500':
          description: Server error

    post:
      tags: [Mini Chat]
      summary: Create a new category (admin)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChatCategoryInput'
      responses:
        '200':
          description: Category created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChatCategory'
        '400':
          description: Validation error
        '500':
          description: Server error

  /api/miniChat/categories/{id}:
    get:
      tags: [Mini Chat]
      summary: Get a category by ID with messages
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Category data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChatCategory'
        '404':
          description: Category not found
        '500':
          description: Server error

    put:
      tags: [Mini Chat]
      summary: Update a category (admin)
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChatCategoryInput'
      responses:
        '200':
          description: Category updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChatCategory'
        '500':
          description: Server error

    delete:
      tags: [Mini Chat]
      summary: Delete a category (admin)
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Category deleted
          content:
            application/json:
              schema:
                type: object
                properties:
                  deleted:
                    type: boolean
        '500':
          description: Server error

  /api/miniChat/categories/{categoryId}/messages:
    get:
      tags: [Mini Chat]
      summary: Get messages of a specific category
      parameters:
        - name: categoryId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: List of messages
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ChatMessage'
        '500':
          description: Server error

  /api/miniChat/messages:
    post:
      tags: [Mini Chat]
      summary: Create a new message (admin)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChatMessageInput'
      responses:
        '200':
          description: Message created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChatMessage'
        '500':
          description: Server error

  /api/miniChat/messages/{id}:
    put:
      tags: [Mini Chat]
      summary: Update a message (admin)
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChatMessageInput'
      responses:
        '200':
          description: Message updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChatMessage'
        '500':
          description: Server error

    delete:
      tags: [Mini Chat]
      summary: Delete a message (admin)
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Message deleted
          content:
            application/json:
              schema:
                type: object
                properties:
                  deleted:
                    type: boolean
        '500':
          description: Server error

  # ===================== LOCATION =====================
  /api/location/provinces:
    get:
      tags: [Location]
      summary: Get all provinces
      responses:
        '200':
          description: List of provinces
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Province'
        '500':
          description: Server error

  /api/location/provinces/{provinceId}/cities:
    get:
      tags: [Location]
      summary: Get cities of a province
      parameters:
        - name: provinceId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: List of cities
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/City'
        '400':
          description: Invalid provinceId
        '500':
          description: Server error

  # ===================== SHOP (public) =====================
  /api/shop/items:
    get:
      tags: [Shop]
      summary: Get active shop items
      responses:
        '200':
          description: List of shop items
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ShopItem'
        '500':
          description: Server error

  /api/shop/purchase:
    post:
      tags: [Shop]
      summary: Purchase a shop item
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PurchaseRequest'
      responses:
        '200':
          description: Purchase successful
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ShopTransaction'
        '400':
          description: Invalid request or insufficient balance
        '401':
          description: Not authenticated
        '500':
          description: Server error

  # ===================== COLLECTION =====================
  /api/collection/items:
    get:
      tags: [Collection]
      summary: Get user's collection (owned items grouped by type)
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Collection data
          content:
            application/json:
              schema:
                type: object
                additionalProperties:
                  type: array
                  items:
                    $ref: '#/components/schemas/UserInventoryItem'
        '401':
          description: Not authenticated
        '500':
          description: Server error

  /api/collection/select:
    post:
      tags: [Collection]
      summary: Select an item to use
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                inventoryItemId:
                  type: integer
                category:
                  type: string
                  enum: [dice, checker, cup, board, sticker, avatar, frame]
      responses:
        '200':
          description: Item selected
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
        '400':
          description: Invalid category or item not owned
        '401':
          description: Not authenticated
        '500':
          description: Server error

  /api/collection/selected:
    get:
      tags: [Collection]
      summary: Get currently selected items
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Selected items by category
          content:
            application/json:
              schema:
                type: object
                properties:
                  dice:
                    $ref: '#/components/schemas/InventoryItem'
                  checker:
                    $ref: '#/components/schemas/InventoryItem'
                  cup:
                    $ref: '#/components/schemas/InventoryItem'
                  board:
                    $ref: '#/components/schemas/InventoryItem'
                  sticker:
                    $ref: '#/components/schemas/InventoryItem'
                  avatar:
                    $ref: '#/components/schemas/InventoryItem'
                  frame:
                    $ref: '#/components/schemas/InventoryItem'
        '401':
          description: Not authenticated
        '500':
          description: Server error

  # ===================== LEADERBOARD =====================
  /api/leaderboard/weekly:
    get:
      tags: [Leaderboard]
      summary: Get weekly leaderboard (last 7 days)
      parameters:
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 100
      responses:
        '200':
          description: Leaderboard entries
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LeaderboardEntry'
        '500':
          description: Server error (returns empty array)

  /api/leaderboard/monthly:
    get:
      tags: [Leaderboard]
      summary: Get monthly leaderboard (last 30 days)
      parameters:
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 100
      responses:
        '200':
          description: Leaderboard entries
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LeaderboardEntry'
        '500':
          description: Server error (returns empty array)

  /api/leaderboard/alltime:
    get:
      tags: [Leaderboard]
      summary: Get all‑time leaderboard
      parameters:
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 100
      responses:
        '200':
          description: Leaderboard entries
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LeaderboardEntry'
        '500':
          description: Server error (returns empty array)

  # ===================== TOURNAMENT =====================
  /api/tournament/current/{type}:
    get:
      tags: [Tournament]
      summary: Get current tournament season
      description: Returns active season for given type (WEEKLY or MONTHLY)
      parameters:
        - name: type
          in: path
          required: true
          schema:
            $ref: '#/components/schemas/TournamentType'
      responses:
        '200':
          description: Current season data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TournamentSeason'
        '404':
          description: No active season found
        '500':
          description: Server error

  /api/tournament/monthly/leaderboard/{seasonId}:
    get:
      tags: [Tournament]
      summary: Get monthly tournament leaderboard
      description: Returns leaderboard for a given monthly season with tie‑breakers applied.
      parameters:
        - name: seasonId
          in: path
          required: true
          schema:
            type: integer
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 100
      responses:
        '200':
          description: Leaderboard entries
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TournamentLeaderboardEntry'
        '500':
          description: Server error

  /api/tournament/weekly/leaderboard/{seasonId}:
    get:
      tags: [Tournament]
      summary: Get weekly tournament leaderboard
      description: Returns leaderboard for a given weekly season. Only players with at least 5 games are included.
      parameters:
        - name: seasonId
          in: path
          required: true
          schema:
            type: integer
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 100
      responses:
        '200':
          description: Leaderboard entries
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TournamentLeaderboardEntry'
        '500':
          description: Server error

  /api/tournament/monthly/active:
    get:
      tags: [Tournament]
      summary: Get current user's active monthly series
      description: Returns the active series (24h window) for the authenticated user, or null if none.
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Active series or null
          content:
            application/json:
              schema:
                nullable: true
                allOf:
                  - $ref: '#/components/schemas/TournamentSeries'
        '401':
          description: Not authenticated
        '500':
          description: Server error

  /api/tournament/monthly/history/{playerId}:
    get:
      tags: [Tournament]
      summary: Get monthly series history for a player
      parameters:
        - name: playerId
          in: path
          required: true
          schema:
            type: integer
        - name: seasonId
          in: query
          required: false
          schema:
            type: integer
      responses:
        '200':
          description: List of recorded series
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TournamentSeries'
        '500':
          description: Server error

  /api/tournament/ticket/balance:
    get:
      tags: [Tournament]
      summary: Get current user's golden ticket balance
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Ticket balance
          content:
            application/json:
              schema:
                type: object
                properties:
                  balance:
                    type: integer
                    example: 5
        '401':
          description: Not authenticated
        '500':
          description: Server error

  # ===================== ADMIN =====================
  /api/admin/inventory:
    get:
      tags: [Admin]
      summary: Get all inventory items (admin)
      security:
        - bearerAuth: []
      responses:
        '200':
          description: List of all inventory items
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/InventoryItem'
        '401':
          description: Not authenticated
        '403':
          description: Admin access required
        '500':
          description: Server error

    post:
      tags: [Admin]
      summary: Create a new inventory item (admin)
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/InventoryItemInput'
      responses:
        '200':
          description: Inventory item created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InventoryItem'
        '400':
          description: Validation error
        '401':
          description: Not authenticated
        '403':
          description: Admin access required
        '500':
          description: Server error

  /api/admin/inventory/{id}:
    get:
      tags: [Admin]
      summary: Get an inventory item by ID (admin)
      security:
        - bearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
