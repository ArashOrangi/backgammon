          type: integer
        seriesId:
          type: integer
        matchIndex:
          type: integer
        gameId:
          type: integer
          nullable: true
        result:
          $ref: '#/components/schemas/MatchResultType'
        baseScore:
          type: integer
        pipBonus:
          type: integer
        cleanBonus:
          type: integer
        totalScore:
          type: integer
        isForfeit:
          type: boolean
        isValid:
          type: boolean
        finishedAt:
          type: string
          format: date-time
          nullable: true

    MatchResultType:
      type: string
      enum: [normal, gammon, backgammon, timer, doublingcube, leave, forfeit, loss]

    TournamentSeries:
      type: object
      properties:
        id:
          type: integer
        playerId:
          type: integer
        seasonId:
          type: integer
        status:
          $ref: '#/components/schemas/SeriesStatus'
        startedAt:
          type: string
          format: date-time
        expiresAt:
          type: string
          format: date-time
        closedAt:
          type: string
          format: date-time
          nullable: true
        totalScore:
          type: integer
        isRecorded:
          type: boolean
        gamesCount:
          type: integer
        bestSingleScore:
          type: integer
          nullable: true
        totalBackgammonWins:
          type: integer
        totalMarsWins:
          type: integer
        totalPipAdvantage:
          type: integer
        totalForfeits:
          type: integer
        achievedAt:
          type: string
          format: date-time
          nullable: true
        games:
          type: array
          items:
            $ref: '#/components/schemas/TournamentGame'

    TournamentLeaderboardEntry:
      type: object
      properties:
        id:
          type: integer
        seasonId:
          type: integer
        playerId:
          type: integer
        finalScore:
          type: integer
        bestSeriesIds:
          type: array
          items:
            type: integer
        bestSingleScore:
          type: integer
        totalBackgammonWins:
          type: integer
        totalMarsWins:
          type: integer
        avgPipAdvantage:
          type: number
        totalForfeits:
          type: integer
        seriesCount:
          type: integer
        achievedAt:
          type: string
          format: date-time
          nullable: true
        rank:
          type: integer
          nullable: true
        player:
          type: object
          properties:
            id:
              type: integer
            userName:
              type: string
            avatar:
              type: string
              nullable: true
            title:
              type: string
              nullable: true

    # ---------- USER STATS ----------
    UserStats:
      type: object
      properties:
        id:
          type: integer
        userId:
          type: integer
        xp:
          type: integer
          nullable: true
        level:
          type: integer
          nullable: true
        coin:
          type: integer
          nullable: true
        gem:
          type: integer
          nullable: true