  # ===================== WEB SOCKET =====================
  /:
    get:
      tags: [WebSocket]
      summary: WebSocket endpoint (upgrade to WS)
      description: |
        Connect using `ws://localhost:8080` (or `wss://`).
        All messages are JSON with `type` and `payload` fields.

        **Client → Server events:**
        - `game.join` – `{ gameId: number, userId: number, roomType?: string }`
        - `game.roll` – `{ gameId: number }`
        - `game.move` – `{ gameId: number, from: number, to: number, die?: number, isUndo?: boolean }`
        - `player.leave` – `{ gameId: number }`
        - `player.ready` – `{ gameId: number }`
        - `game.endTurn` – `{ gameId: number }`
        - `game.cube.offer` – `{ gameId: number }`
        - `game.cube.respond` – `{ gameId: number, accept: boolean }`
        - `game.practice.bearoff` – `{ gameId: number }`
        - `game.practice.rearrange` – `{ gameId: number, points: Array<{index, count}> }`
        - `game.practice.setup_board` – `{ gameId: number, board: { points, bar, borneOff } }`
        - `tournament.monthly.start` – `{ seasonId: number }`
        - `tournament.monthly.close` – `{ seriesId: number }`
        - `tournament.matchmaking.join` – `{ seasonId: number, type: "WEEKLY"|"MONTHLY" }`
        - `tournament.matchmaking.cancel` – `{ type: "WEEKLY"|"MONTHLY" }`

        **Server → Client events:**
        - `game.state` – full `GameState`
        - `game.error` – `{ message: string }`
        - `game.turn` – `{ playerId, color }`
        - `dice.result` – `{ dice, playerId, type? }`
        - `player.move` – array of move objects
        - `game.cube.offer`, `game.cube.accepted`, `game.cube.rejected`
        - `turn.timeout`, `network.timeout`
        - `game.result` – `{ winner, winType, reason, score }`
        - `timer.started` – `{ playerId, primaryTime, secondaryTime, turnStartedAt }`
        - `timer.warning` – `{ remaining, playerId }`
        - `tournament.monthly.start_res` – `{ seriesId: number, expiresAt: string }`
        - `tournament.monthly.close_res` – `{ success: boolean, seriesId: number, status: "CLOSED_BY_PLAYER" | "COMPLETED" }`
        - `tournament.matchmaking.join_res` – `{ status: "searching" }`
        - `tournament.matchmaking.cancel_res` – `{ status: "cancelled" }`
        - `tournament.match_found` – `{ gameId: number, opponent: { id: number, userName: string, avatar: string } }`
        - `tournament.series_closed` – `{ seriesId: number, status: "COMPLETED" | "EXPIRED" }`
        - `progression.updated` – `{ userId: number, previousStats: { xp: number, level: number, coin: number, gem: number }, gained: { xp: number, coin: number, gem: number }, newStats: { xp: number, level: number, coin: number, gem: number }, levelUp: boolean, previousLevel: number, newLevel: number }`

      responses:
        '101':
          description: WebSocket upgrade

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:
    # ---------- USER ----------
    User:
      type: object
      properties:
        id:
          type: integer
        userName:
          type: string
        phoneNumber:
          type: string
          nullable: true
        lastOnline:
          type: string
          format: date-time
        isLocked:
          type: boolean
        winRate:
          type: number
        mmr:
          type: integer
        winStreak:
          type: integer
        lossStreak:
          type: integer
        recentResults:
          type: array
          items:
            type: boolean
        recentOpponents:
          type: array
          items:
            type: object
            properties:
              opponentId:
                type: integer
              timestamp:
                type: integer
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
        gender:
          type: string
          enum: [MAN, WOMAN, OTHER]
          nullable: true
        level:
          type: integer
          nullable: true
        provinceId:
          type: integer
          nullable: true
        cityId:
          type: integer
          nullable: true
        avatar:
          type: string
          nullable: true
        frame:
          type: string
          nullable: true
        title:
          type: string
          nullable: true
        selectedDiceId:
          type: integer
          nullable: true
        selectedCheckerId:
          type: integer
          nullable: true
        selectedCupId:
          type: integer
          nullable: true
        selectedBoardId:
          type: integer
          nullable: true
        selectedStickerId:
          type: integer
          nullable: true
        totalWins:
          type: integer
        totalMars:
          type: integer
        totalBackgammon:
          type: integer
        totalMatches:
          type: integer

    ProfileResponse:
      type: object
      allOf:
        - $ref: '#/components/schemas/User'
        - type: object
          properties:
            xp:
              type: integer
            coin:
              type: integer
            gem:
              type: integer
            commonMatches:
              type: integer
            lastMatchDate:
              type: string
              format: date-time
              nullable: true
            lastMatchResult:
              type: string
              nullable: true

    # ---------- AUTH ----------
    RegisterRequest:
      type: object
      required:
        - userName
        - password
      properties:
        userName:
          type: string
          minLength: 3
          maxLength: 50
        password:
          type: string
          minLength: 8
          maxLength: 100
        phoneNumber:
          type: string
          pattern: '^[0-9]{11}$'
        gender:
          type: string
          enum: [MAN, WOMAN, OTHER]

    LoginRequest:
      type: object
      required:
        - userName
        - password
      properties:
        userName:
          type: string
        password:
          type: string

    ChangePasswordRequest:
      type: object
      required:
        - newPassword
      properties:
        oldPassword:
          type: string
        newPassword:
          type: string
          minLength: 6
          maxLength: 16

    AuthResponse:
      type: object
      properties:
        user:
          $ref: '#/components/schemas/User'
        token:
          type: string

    SimpleUserRequest:
      type: object
      required:
        - userName
      properties:
        userName:
          type: string
          minLength: 1
          maxLength: 100

    UpdateProfileRequest:
      type: object
      properties:
        provinceId:
          type: integer
          minimum: 1
        cityId:
          type: integer
          minimum: 1
        image:
          type: string
          maxLength: 500
        phoneNumber:
          type: string
          pattern: '^[0-9]{11}$'

    # ---------- GAME ----------
    Game:
      type: object
      properties:
        id:
          type: integer
        status:
          type: string
          enum: [waiting, ready, starting, in-progress, finished]
        whitePlayerId:
          type: integer
          nullable: true
        blackPlayerId:
          type: integer
          nullable: true
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    # ---------- ROOM TYPE (UPDATED) ----------
    RoomType:
      type: string
      enum:
        - ROOM1
        - ROOM2
        - ROOM3
        - ROOM4
        - ROOM5
        - ROOM6
        - ROOM7
        - ROOM8
        - ROOM9

    GameState:
      type: object
      description: Full game state (simplified for documentation)
      properties:
        id:
          type: integer
        players:
          type: array
          items:
            type: object
            properties:
              id:
                type: integer
              color:
                type: string
                enum: [white, black]
        turn:
          type: integer
          nullable: true
        status:
          type: string
        board:
          type: object
        dice:
          type: array
          items:
            type: integer
        cubeValue:
          type: integer
        cubeOwner:
          type: integer
          nullable: true
        winType:
          type: string
          enum: [normal, mars, backgammon]
        score:
          type: integer

    # ---------- TIMER PRESET ----------
    TimerPreset:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string
        primarySeconds:
          type: integer
        secondarySeconds:
          type: integer
        leagueLevel:
          type: integer
          nullable: true
        gameType:
          type: string
          nullable: true
        isDefault:
          type: boolean

    TimerPresetInput:
      type: object
      required:
        - name
        - primarySeconds
        - secondarySeconds
      properties:
        name:
          type: string
        primarySeconds:
          type: integer
        secondarySeconds:
          type: integer
        leagueLevel:
          type: integer
          nullable: true
        gameType:
          type: string
          nullable: true
        isDefault:
          type: boolean

    # ---------- CHAT ----------
    ChatCategory:
      type: object
      properties:
        id:
          type: integer
        nameFa:
          type: string
        nameEn:
          type: string
          nullable: true
        isFree:
          type: boolean
        conditions:
          type: object
          nullable: true
        lock:
          type: boolean
        isActive:
          type: boolean
        messages:
          type: array
          items:
            $ref: '#/components/schemas/ChatMessage'

    ChatCategoryInput:
      type: object
      required:
        - nameFa
      properties:
        nameFa:
          type: string
        nameEn:
          type: string
        isFree:
          type: boolean
        conditions:
          type: object
        lock:
          type: boolean
        isActive:
          type: boolean

    ChatMessage:
      type: object
      properties:
        id:
          type: integer
        message:
          type: string
        categoryId:
          type: integer
        order:
          type: integer
          nullable: true
        isActive:
          type: boolean

    ChatMessageInput:
      type: object
      required:
        - message
        - categoryId
      properties:
        message:
          type: string
        categoryId:
          type: integer
        order:
          type: integer
        isActive:
          type: boolean

    # ---------- LOCATION ----------
    Province:
      type: object
      properties:
        id:
          type: integer
        faName:
          type: string
        enName:
          type: string
        isCapital:
          type: boolean

    City:
      type: object
      properties:
        id:
          type: integer
        faName:
          type: string
        enName:
          type: string
        isCapital:
          type: boolean
        latitude:
          type: number
          nullable: true
        longitude:
          type: number
          nullable: true

    # ---------- SHOP ----------
    ShopItem:
      type: object
      properties:
        id:
          type: integer
        inventoryItemId:
          type: integer
        type:
          type: string
          enum: [ITEM, PACKAGE, CURRENCY]
        coinPrice:
          type: integer
          nullable: true
        diamondPrice:
          type: integer
          nullable: true
        realPrice:
          type: number
          nullable: true
        discountCoinPrice:
          type: integer
          nullable: true
        discountDiamondPrice:
          type: integer
          nullable: true
        discountRealPrice:
          type: number
          nullable: true
        discountStartDate:
          type: string
          format: date-time
          nullable: true
        discountEndDate:
          type: string
          format: date-time
          nullable: true
        packageCoin:
          type: integer
          nullable: true
        packageDiamond:
          type: integer
          nullable: true
        packageItems:
          type: array
          items:
            type: object
            properties:
              inventoryItemId:
                type: integer
              amount:
                type: integer
        isActive:
          type: boolean
        sortOrder:
          type: integer

    ShopItemInput:
      type: object
      properties:
        name:
          type: string
        description:
          type: string
        type:
          $ref: '#/components/schemas/ShopItemType'
        inventoryItemId:
          type: integer
        coinPrice:
          type: integer
        diamondPrice:
          type: integer
        realPrice:
          type: number
        realCurrency:
          type: string
        discountCoinPrice:
          type: integer
        discountDiamondPrice:
          type: integer
        discountRealPrice:
          type: number
        discountStartDate:
          type: string
          format: date-time
        discountEndDate:
          type: string
          format: date-time
        packageItems:
          type: array
          items:
            type: object
            properties:
              inventoryItemId:
                type: integer
              amount:
                type: integer
        packageCoin:
          type: integer
        packageDiamond:
          type: integer
        isActive:
          type: boolean
        sortOrder:
          type: integer
        displayImage:
          type: string

    ShopItemType:
      type: string
      enum: [ITEM, PACKAGE, CURRENCY]

    PurchaseRequest:
      type: object
      required:
        - shopItemId
        - currencyType
      properties:
        shopItemId:
          type: integer
        currencyType:
          type: string
          enum: [COIN, DIAMOND, REAL]
        realAmount:
          type: number
        realCurrency:
          type: string

    ShopTransaction:
      type: object
      properties:
        id:
          type: integer
        userId:
          type: integer
        shopItemId:
          type: integer
        pricePaid:
          type: integer
        currencyType:
          type: string
        realAmount:
          type: number
          nullable: true
        realCurrency:
          type: string
          nullable: true
        createdAt:
          type: string
          format: date-time

    # ---------- COLLECTION ----------
    InventoryItem:
      type: object
      properties:
        id:
          type: integer
        visualCode:
          type: string
        usageType:
          type: string
          enum: [dice, checker, cup, board, sticker, avatar, frame]
        name:
          type: string
        description:
          type: string
          nullable: true
        rarity:
          type: string
          nullable: true

    InventoryItemInput:
      type: object
      required:
        - name
        - visualCode
        - usageType
      properties:
        name:
          type: string
        visualCode:
          type: string
        usageType:
          type: string
          enum: [dice, checker, cup, board, sticker, avatar, frame]

    UserInventoryItem:
      type: object
      properties:
        id:
          type: integer
        userId:
          type: integer
        inventoryItemId:
          type: integer
        amount:
          type: integer
        expirationDate:
          type: string
          format: date-time
          nullable: true
        inventoryItem:
          $ref: '#/components/schemas/InventoryItem'

    # ---------- STARTER PACK ----------
    StarterPack:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        description:
          type: string
        items:
          type: array
          items:
            type: object
            properties:
              visualCode:
                type: string
              amount:
                type: integer
        coin:
          type: integer
        diamond:
          type: integer

    # ---------- LEADERBOARD ----------
    LeaderboardEntry:
      type: object
      properties:
        userId:
          type: integer
        userName:
          type: string
        mmr:
          type: integer
        winRate:
          type: number
        avatar:
          type: string
          nullable: true
        title:
          type: string
          nullable: true
        totalLBPoints:
          type: integer

    # ---------- TOURNAMENT ----------
    TournamentType:
      type: string
      enum: [WEEKLY, MONTHLY]

    TournamentStatus:
      type: string
      enum: [ACTIVE, FINALIZED]

    SeriesStatus:
      type: string
      enum: [ACTIVE, COMPLETED, CLOSED_BY_PLAYER, EXPIRED]

    TournamentSeason:
      type: object
      properties:
        id:
          type: integer
        type:
          $ref: '#/components/schemas/TournamentType'
        startDate:
          type: string
          format: date-time
        endDate:
          type: string
          format: date-time
        status:
          $ref: '#/components/schemas/TournamentStatus'
        ticketPrice:
          type: integer
          description: Entry cost in golden tickets
        minGamesForRanking:
          type: integer
          description: Minimum games required for weekly leaderboard eligibility
        bestCount:
          type: integer
          description: Number of best results counted (weekly=20, monthly=5)
        prizePool:
          type: object
          description: JSON with prize distribution (first, top10, milestones)
          example: { first: 1000, top10: 100, milestone10: 50, milestone15: 75 }

    TournamentGame:
      type: object
