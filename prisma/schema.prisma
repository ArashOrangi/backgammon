generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  مدل‌های گیم‌پلی
// ============================================================

model Games {
  id          Int         @id @default(autoincrement())
  status      GAMESTATUS  @default(PENDING)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime?   @updatedAt @db.Timestamptz(3)
  whitePlayerId Int?
  blackPlayerId Int?
  whitePlayer User? @relation("WhitePlayerRelation", fields: [whitePlayerId], references: [id])
  blackPlayer User? @relation("BlackPlayerRelation", fields: [blackPlayerId], references: [id])
  events      GameEvents[]
  snapshots   GameSnapshots[]
  matchRecords MatchRecord[]
  lbRecords   MatchLBRecord[]
  xpHistories XPHistory[]

  @@index([whitePlayerId])
  @@index([blackPlayerId])
}

enum GAMESTATUS {
  PENDING
  ACTIVE
  FINISHED
}

model GameEvents {
  id         Int        @id @default(autoincrement())
  gameId     Int
  sequence   Int
  type       EVENTTYPE
  payload    Json
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime?  @updatedAt @db.Timestamptz(3)
  isUndo     Boolean    @default(false)
  game       Games      @relation(fields: [gameId], references: [id])

  @@unique([gameId, sequence])
  @@index([gameId, sequence])
}

enum EVENTTYPE {
  PLAYER_JOINED
  PLAYER_LEFT
  GAME_STARTING
  GAME_STARTED
  STARTING_ROLLED
  DICE_ROLLED
  MOVE_APPLIED
  TURN_PASSED
  CUBE_OFFERED
  CUBE_ACCEPTED
  CUBE_REJECTED
  GAME_FINISHED
  TURN_TIMEOUT
  NETWORK_TIMEOUT
  MANUAL_END
}

model GameSnapshots {
  id            Int      @id @default(autoincrement())
  gameId        Int
  sequence      Int
  state         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastSequence  Int?
  game          Games    @relation(fields: [gameId], references: [id])

  @@unique([gameId, sequence])
}

model TimerPreset {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  primarySeconds   Int
  secondarySeconds Int
  leagueLevel      Int?
  gameType         String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@map("timer_presets")
}

// ============================================================
//  مدل‌های اصلی (User و وابسته‌ها)
// ============================================================

model User {
  id            Int      @id @default(autoincrement())
  userName      String   @unique @map("Username")
  botPresetId   Int?     @map("BotPreset_Id")
  joinDate      DateTime @default(now()) @db.Timestamptz(3) @map("JoinDate")
  phoneNumber   String?  @map("PhoneNumber")
  lastOnline    DateTime @default(now()) @db.Timestamptz(3) @map("LastOnline")
  isLocked      Boolean  @default(false) @map("IsLocked")

  // ===== فیلدهای گیم‌پلی =====
  winRate       Float    @default(0)
  mmr           Int      @default(0)
  winStreak     Int      @default(0)
  lossStreak    Int      @default(0)
  recentResults Json?
  recentOpponents Json?
  gender        GENDER   @default(MAN)
  level         Int?
  password      String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // ===== فیلدهای پروفایل =====
  avatar        String?   // تصویر پروفایل
  frame         String?   // قاب عکس
  title         String?   // لقب

  // ===== فیلدهای شخصی‌سازی (انتخاب آیتم‌ها) =====
  selectedDiceId     Int?
  selectedCheckerId  Int?
  selectedCupId      Int?
  selectedBoardId    Int?
  selectedStickerId  Int?
  selectedAvatarId   Int?   // جدید
  selectedFrameId    Int?   // جدید

  // ===== آمار بازی =====
  totalWins     Int     @default(0)
  totalMars     Int     @default(0)
  totalBackgammon Int   @default(0)
  totalMatches  Int     @default(0)

  // ===== فیلدهای مکان =====
  provinceId    Int?
  cityId        Int?

  // ---------- Relation‌ها ----------

  province      Provinces? @relation("USER_PROVINCE", fields: [provinceId], references: [id])
  city          Cities?    @relation("USER_CITY", fields: [cityId], references: [id])
  botPreset     BotPreset? @relation(fields: [botPresetId], references: [id])
  whiteGames    Games[] @relation("WhitePlayerRelation")
  blackGames    Games[] @relation("BlackPlayerRelation")

  // روابط انتخاب آیتم‌ها
  selectedDice     InventoryItem? @relation("SelectedDice", fields: [selectedDiceId], references: [id])
  selectedChecker  InventoryItem? @relation("SelectedChecker", fields: [selectedCheckerId], references: [id])
  selectedCup      InventoryItem? @relation("SelectedCup", fields: [selectedCupId], references: [id])
  selectedBoard    InventoryItem? @relation("SelectedBoard", fields: [selectedBoardId], references: [id])
  selectedSticker  InventoryItem? @relation("SelectedSticker", fields: [selectedStickerId], references: [id])
  selectedAvatar   InventoryItem? @relation("SelectedAvatar", fields: [selectedAvatarId], references: [id])
  selectedFrame    InventoryItem? @relation("SelectedFrame", fields: [selectedFrameId], references: [id])

  stats         UserStats?
  additional    AdditionalStat[]
  matchParticipants MatchParticipent[]
  reportsAsReporter UserReport[] @relation("Reporter")
  reportsAsProfile  UserReport[] @relation("ReportedProfile")
  flags         UserFlag[]
  inventory     UserInventoryItem[]
  coinHistory   UserCoinHistory[]
  lbRecordsAsPlayer   MatchLBRecord[] @relation("PlayerLB")
  lbRecordsAsOpponent MatchLBRecord[] @relation("OpponentLB")
  xpHistories         XPHistory[]
  shopTransactions    ShopTransaction[]

  @@map("User")
}

enum GENDER {
  MAN
  WOMAN
  OTHER
}

// ============================================================
//  مدل‌های مکان (Provinces & Cities)
// ============================================================

model Provinces {
  id        Int       @id @default(autoincrement())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  faName    String    @unique @db.VarChar(99)
  isCapital Boolean   @default(false)
  enName    String?   @unique @db.VarChar(99)
  about     String?
  
  cities    Cities[]  @relation("PROVINCE_CITIES")
  users     User[]    @relation("USER_PROVINCE")

  @@map("Provinces")
}

model Cities {
  id         Int           @id @default(autoincrement())
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime?     @updatedAt @db.Timestamptz(3)
  faName     String        @db.VarChar(99)
  isCapital  Boolean       @default(false)
  enName     String?       @db.VarChar(99)
  about      String?
  latitude   Float?
  longitude  Float?
  population Int?
  provinceId Int
  
  province   Provinces     @relation("PROVINCE_CITIES", fields: [provinceId], references: [id])
  users      User[]        @relation("USER_CITY")

  @@map("Cities")
}

// ============================================================
//  مدل‌های Inventory (شخصی‌سازی)
// ============================================================

model InventoryItem {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(255)
  visualCode String  @db.VarChar(255) @map("VisualCode")
  usageType  Bytes   @db.ByteA @map("UsageType") // dice, checker, cup, board, sticker, frame, avatar
  
  userItems  UserInventoryItem[]
  
  // روابط انتخاب‌شده توسط کاربران (یک‌به‌یک)
  selectedByDice    User[] @relation("SelectedDice")
  selectedByChecker User[] @relation("SelectedChecker")
  selectedByCup     User[] @relation("SelectedCup")
  selectedByBoard   User[] @relation("SelectedBoard")
  selectedBySticker User[] @relation("SelectedSticker")
  selectedByAvatar  User[] @relation("SelectedAvatar")   // جدید
  selectedByFrame   User[] @relation("SelectedFrame")    // جدید

  // آیتم‌های فروشگاه مرتبط (برای آیتم‌های تکی)
  shopItems         ShopItem[]

  @@map("InventoryItem")
}

model UserInventoryItem {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("User_Id")
  inventoryItemId  Int            @map("InventoryItem_Id")
  amount           Int
  expirationDate   DateTime?      @db.Timestamptz(3) @map("ExpirationDate")

  user             User           @relation(fields: [userId], references: [id])
  inventoryItem    InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@map("UserInventoryItem")
}

// ============================================================
//  مدل‌های آمار و پیشرفت (Progression)
// ============================================================

model UserStats {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  user      User    @relation(fields: [userId], references: [id])
  xp        Int?
  level     Int?    @db.SmallInt
  coin      Int?
  gem       Int?

  @@map("UserStats")
}

model AdditionalStat {
  id      Int     @id @default(autoincrement())
  userId  Int
  user    User    @relation(fields: [userId], references: [id])
  name    String  @db.VarChar(255)
  amount  Int

  @@map("AdditionalStat")
}

model LevelIntrepeter {
  xp            Int     @id @map("XP")
  level         Int?    @map("Level")
  cumulativeXP  Int?    @map("cumulative_xp")
  xpToNext      Int?    @map("xp_to_next")

  @@map("LevelIntrepeter")
}

// ============================================================
//  مدل‌های اتاق‌ها و مچ‌میکینگ
// ============================================================

enum RoomType {
  CASUAL_1
  CASUAL_2
  COMPETITIVE_1
  COMPETITIVE_2
}

model RoomPreset {
  id             Int     @id @default(autoincrement())
  minXp          Int?    @map("minimum required XP")
  matchmakingQueue Int?  @map("matchmaking queue")
  coinBuyIn      Int?    @map("coin buy in")
  coinReward     Int?    @map("coin reward")
  timer          Int?
  doublingCube   Int?    @map("doubling cube")
  undo           Int?
  rewardXp       Int?    @map("reward xp")
  leaderboardPoint Int?  @map("leaderboard point")
  baseWinXP      Int?    @map("base_win_xp")
  baseLoseXP     Int?    @map("base_lose_xp")
  spread         Int?    @map("spread")

  matchRecords   MatchRecord[]

  @@map("RoomPreset")
}

// ============================================================
//  مدل‌های مسابقات (Match)
// ============================================================

model MatchRecord {
  id            Int           @id @default(autoincrement())
  roomPresetId  Int?          @map("RoomStats id")
  roomPreset    RoomPreset?   @relation(fields: [roomPresetId], references: [id])
  diceRecord    Int?          @map("dice record")
  startMatch    DateTime      @db.Timestamptz(3) @map("StartMatch")
  endMatch      DateTime?     @db.Timestamptz(3) @map("EndMatch")
  matchLength   Int?          @map("MatchLenght")
  gameId        Int?
  game          Games?        @relation(fields: [gameId], references: [id])

  participants  MatchParticipent[]
  timeline      MatchTimline[]

  @@map("MatchRecord")
}

model MatchParticipent {
  id                 Int                     @id @default(autoincrement())
  matchRecordId      Int                     @map("MatchRecord_Id")
  matchRecord        MatchRecord             @relation(fields: [matchRecordId], references: [id])
  playerId           Int                     @map("Player_Id")
  player             User                    @relation(fields: [playerId], references: [id])
  side               Boolean?
  result             Boolean?
  resultType         MatchResultType?        @map("ResultType")
  hits               Int                     @default(0)
  minichatUsed       Boolean                 @default(false) @map("MinichatUsed")
  stickersUsed       Boolean                 @default(false) @map("StickersUsed")
  doublingCubeUseCount Int                   @default(0) @map("DoublingCubeUseCount")

  disconnectRecords  MatchParticipentDisconnect[]
  tournamentRecords  TournamentParticipentRecord[]

  @@map("MatchParticipent")
}

enum MatchResultType {
  normal
  gammon
  backgammon
  timer
  doublingcube
  leave
}

model MatchTimline {
  id            Int           @id @default(autoincrement())
  matchRecordId Int?          @map("MatchRecord_Id")
  matchRecord   MatchRecord?  @relation(fields: [matchRecordId], references: [id])
  initiatorId   Int?          @map("Initiator_Id")
  sequence      Int?          @map("Sequence")
  time          DateTime      @db.Timestamptz(3) @map("Time")
  event         String?       @db.VarChar(255) @map("Event")
  revert        Boolean?      @map("Revert")
  details       String?       @db.VarChar(255) @map("Details")

  @@map("MatchTimline")
}

model MatchParticipentDisconnect {
  matchParticipentId Int      @map("MatchParticipent_Id")
  time               DateTime @db.Timestamptz(3) @map("Time")

  matchParticipent MatchParticipent @relation(fields: [matchParticipentId], references: [id])

  @@id([matchParticipentId, time])
  @@map("MatchParticipentDisconnect")
}

// ============================================================
//  مدل‌های تورنومنت‌ها
// ============================================================

model TournamentPreset {
  id                Int     @id @default(autoincrement())
  tournamentType    Bytes   @db.ByteA @map("TournamentType")
  groupCount        Int     @map("GroupCount")
  gamePerGroup      Int     @map("GamePerGroup")

  participations    TournamentParticipentRecord[]

  @@map("TournamentPreset")
}

model TournamentParticipentRecord {
  id                           Int               @id @default(autoincrement())
  tournamentMatchParticipemntId Int              @map("TournamentMatchParticipemnt_Id")
  matchParticipent             MatchParticipent  @relation(fields: [tournamentMatchParticipemntId], references: [id])
  tournamentPresetId           Int               @map("TournamentPreset_Id")
  tournamentPreset             TournamentPreset  @relation(fields: [tournamentPresetId], references: [id])

  @@map("TournamentParticipentRecord")
}

// ============================================================
//  مدل‌های گزارش، پرچم و مالی
// ============================================================

model UserReport {
  id          Int     @id @default(autoincrement())
  reporterId  Int     @map("Reporter_Id")
  reporter    User    @relation("Reporter", fields: [reporterId], references: [id])
  profileId   Int     @map("Profile_Id")
  profile     User    @relation("ReportedProfile", fields: [profileId], references: [id])
  type        Bytes   @db.ByteA
  info        String? @db.VarChar(255) @map("Info")

  @@map("UserReport")
}

model UserFlag {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("User_Id")
  user              User     @relation(fields: [userId], references: [id])
  type              Bytes    @db.ByteA
  checked           Boolean
  restrict          Boolean
  gameRestrict      Boolean  @map("GameRestrict")
  tournamentRestrict Boolean @map("TournamentRestrict")
  chatRestrict      Boolean  @map("ChatRestrict")

  @@map("UserFlag")
}

model PaymentRecord {
  id        Int     @id @default(autoincrement())
  clientId  Int?    @map("client_id")
  amount    BigInt? @map("amount")
  date      DateTime? @db.Date @map("date")

  coinHistories UserCoinHistory[]

  @@map("PaymentRecord")
}

model UserCoinHistory {
  id          Int            @id @default(autoincrement())
  clientId    Int?           @map("client_id")
  amount      BigInt?        @map("amount")
  date        DateTime?      @db.Date @map("date")
  initiatorId Int?           @map("initiator_id")
  initiator   PaymentRecord? @relation(fields: [initiatorId], references: [id])
  user        User?          @relation(fields: [clientId], references: [id])
  
  @@map("UserCoinHistory")
}

// ============================================================
//  مدل‌های ربات
// ============================================================

model BotPreset {
  id    Int    @id @default(autoincrement())
  users User[]

  @@map("BotPreset")
}

// ============================================================
//  مدل‌های مینی‌چت
// ============================================================

model MessagesCategory {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  isActive  Boolean  @default(true)
  nameFa     String   @unique
  nameEn     String?
  isFree     Boolean  @default(false)
  buyCount   Int?
  conditions Json?    @db.Json
  lock       Boolean  @default(false)
  messages   StaticMessages[] @relation("MSG_CATEGORY")
}

model StaticMessages {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  isActive   Boolean  @default(true)
  message    String
  order      Int?
  categoryId Int
  category   MessagesCategory @relation("MSG_CATEGORY", fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive])
}

// ============================================================
//  مدل‌های جدید برای سیستم‌های Progression, Economy, Leaderboard
// ============================================================

model MatchLBRecord {
  id                   Int        @id @default(autoincrement())
  userId               Int
  opponentId           Int
  gameId               Int
  roomType             RoomType
  isWin                Boolean
  winType              String?
  repetitionMultiplier Float
  basePoints           Int
  bonusPoints          Int
  totalLBPoints        Int
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)

  user                 User       @relation("PlayerLB", fields: [userId], references: [id])
  opponent             User       @relation("OpponentLB", fields: [opponentId], references: [id])
  game                 Games      @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([opponentId])
  @@index([gameId])
  @@index([createdAt])
  @@index([roomType])
  @@map("match_lb_records")
}

model XPHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  gameId      Int
  baseXP      Int
  winBonus    Int
  actionBonus Int
  totalXP     Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id])
  game        Games    @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([gameId])
  @@index([createdAt])
  @@map("xp_histories")
}

// ============================================================
//  مدل‌های فروشگاه (Shop) و کلکسیون (Collection)
// ============================================================

enum ShopItemType {
  ITEM      // یک آیتم تکی از InventoryItem
  PACKAGE   // ترکیبی از چند آیتم و/یا ارز
  CURRENCY  // صرفاً خرید ارز (سکه یا الماس)
}

enum CurrencyType {
  COIN
  DIAMOND
  REAL
}

model ShopItem {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(255)
  description         String?        @db.Text
  type                ShopItemType   @default(ITEM)

  // برای آیتم‌های تکی (type = ITEM)
  inventoryItemId     Int?           @map("inventory_item_id")
  inventoryItem       InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  // قیمت‌ها
  coinPrice           Int?           @map("coin_price")
  diamondPrice        Int?           @map("diamond_price")
  realPrice           Float?         @map("real_price")
  realCurrency        String?        @map("real_currency") // e.g., "IRR", "USD"

  // تخفیف‌ها
  discountCoinPrice   Int?           @map("discount_coin_price")
  discountDiamondPrice Int?          @map("discount_diamond_price")
  discountRealPrice   Float?         @map("discount_real_price")
  discountStartDate   DateTime?      @map("discount_start_date") @db.Timestamptz(3)
  discountEndDate     DateTime?      @map("discount_end_date") @db.Timestamptz(3)

  // برای پکیج‌ها (type = PACKAGE یا CURRENCY)
  packageItems        Json?          @map("package_items") // آرایه‌ای از {inventoryItemId, amount}
  packageCoin         Int?           @map("package_coin")
  packageDiamond      Int?           @map("package_diamond")

  isActive            Boolean        @default(true) @map("is_active")
  sortOrder           Int?           @map("sort_order")
  displayImage        String?        @map("display_image")

  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  transactions        ShopTransaction[]

  @@index([isActive])
  @@index([type])
  @@map("shop_items")
}

model ShopTransaction {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  user        User         @relation(fields: [userId], references: [id])
  shopItemId  Int          @map("shop_item_id")
  shopItem    ShopItem     @relation(fields: [shopItemId], references: [id])
  pricePaid   Int?         @map("price_paid") // مبلغ پرداختی (به واحد ارز مربوطه)
  currencyType CurrencyType @default(COIN) @map("currency_type")
  realAmount  Float?       @map("real_amount") // در صورت خرید با پول واقعی
  realCurrency String?     @map("real_currency")
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([shopItemId])
  @@index([createdAt])
  @@map("shop_transactions")
}