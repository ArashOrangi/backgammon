{
  "compilerOptions": {
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceRoot": "./src/",
    "rootDir": "./src/",
    "sourceMap": true,
    "lib": ["esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "ES2017",
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
